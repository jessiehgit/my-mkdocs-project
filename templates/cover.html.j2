<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>封面</title>
    <style>
        /* 移除第一頁的邊距 */
        @page :first {
            margin: 0;
        }
        
        /* 重置所有元素 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            margin: 0;
            padding: 0;
        }
        
        /* 封面容器 */
        #doc-cover {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100vh;
            width: 100%;
            padding: 4rem 3rem;
            font-family: 'Noto Sans TC', 'Microsoft JhengHei', 'PingFang TC', sans-serif;
        }
        
        /* Logo 區域 */
        .logo-section {
            text-align: center;
            padding: 2rem 0;
        }
        
        .logo-section img {
            max-width: 500px;
            max-height: 200px;
            width: auto;
            height: auto;
            display: block;
            margin: 0 auto;
        }
        
        /* 標題區域 */
        .title-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }
        
        h1 {
            font-size: 48pt;
            font-weight: 700;
            color: #1a1a1a;
            margin: 0 0 1.5rem 0;
            line-height: 1.3;
        }
        
        h2 {
            font-size: 22pt;
            font-weight: 400;
            color: #666666;
            margin: 0;
            line-height: 1.5;
        }
        
        /* 底部資訊 */
        .footer-section {
            text-align: right;
            padding: 2rem 0;
        }
        
        .footer-section p {
            font-size: 12pt;
            text-align: right;
            color: #555555;
            margin: 0.6rem 0;
            line-height: 1.4;
        }
        
        .copyright {
            font-size: 10pt;
            color: #888888;
        }
    </style>
</head>
<body>
    <article id="doc-cover">
        <!-- Logo 區域 -->
        {% if cover_logo %}
        <div class="logo-section">
            <img src="file:///C:/mkdocstest/project/my-project/site/zh-tw/{{ cover_logo }}" alt="Logo">
        </div>
        {% endif %}
        
        <!-- 標題區域 -->
        <div class="title-section">
            <div>
                <h1>{{ cover_title }}</h1>
                {% if cover_subtitle %}
                <h2>{{ cover_subtitle }}</h2>
                {% endif %}
            </div>
        </div>
        
        <!-- 底部資訊 -->
        <div class="footer-section">
            {% if author %}
            <p>{{ author }}</p>
            {% endif %}
            {% if copyright %}
            <p class="copyright">{{ copyright }}</p>
            {% endif %}
        </div>
    </article>
</body>
</html>